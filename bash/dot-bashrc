# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific aliases and functions
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/Bin:" ]]
then
    PATH="$HOME/.local/bin:$HOME/Bin:$PATH"
fi
export PATH

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
        for rc in ~/.bashrc.d/*; do
                if [ -f "$rc" ]; then
                        . "$rc"
                fi
        done
fi

unset rc

# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto -h'
    #alias dir='dir --color=auto'
    #alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
else
    alias ls='ls -h'
fi

# some more aliases
alias ll='ls -l'
alias open='xdg-open'
alias clean='rm -f *~ .*~ \#* .\#*'
if [[ -n ${SCRATCH} ]]; then
	alias scr='cd ${SCRATCH}'
else
	alias scr='cd ~/Work'
	if [ ! -d ~/Work ]; then
		mkdir -p ~/Work
	fi
fi
alias fila='squeue --me'
alias afila='watch -n 10 squeue --me --sort=-+P,p'
alias cancelmyjobs="squeue --me -h | awk '{print \$1}' | xargs -I'{}' scancel '{}'"
alias myprojects='sacctmgr -nP show assoc where user=$(whoami) format=account'

# colored GCC warnings and errors
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'

# Replace vi by vim and set vim as default editor
which vim 1> /dev/null 2> /dev/null
if [ $? -eq 0 ]; then
    alias vimdiff='vimdiff -N'
    alias vim='vim -N'
    alias vi='vim'
    export EDITOR=vim
fi

# use Crtl+p and Ctrl+n to navigate through bash history
__iatest=$(expr index "$-" i)
case "$TERM" in
    xterm*|rxvt*|linux|alacritty)
        if [[ ${__iatest} > 0 ]]; then
            bind '"\C-P": history-search-backward'
            bind '"\C-N": history-search-forward'
        fi
    ;;
esac
unset __iatest

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"


# Configure command history
export HISTSIZE=1000000
export HISTFILESIZE=100000000
export HISTTIMEFORMAT='%F %T '

# Force immediate history append
# Useful for multi terminal sections
shopt -s histappend
export PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND$'\n'}history -a; history -c; history -r"

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# Expand environment variables that are directory paths, when pressing tab
shopt -s direxpand

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# environment varibles
export SQUEUE_FORMAT="%.18i %.9P %.30j %.12u %.2t %.10M %.6D %30R %Z"


# custom applications
if [ -d ~/Bin/uenv/bin ]; then
    export PATH=$PATH:~/Bin/uenv/bin
fi
#export PATH=$PATH:~/Bin/reframe/bin

# UV
export UV_TOOL_BIN_DIR=$HOME/.local/$(uname -m)/bin
export UV_TOOL_DIR=$HOME/.local/$(uname -m)/share/uv/tools
export PATH=$UV_TOOL_BIN_DIR:$PATH

# install reframe
__iatest=$(expr index "$-" i)
case "$TERM" in
    xterm*|rxvt*|linux|alacritty)
        if [[ ${__iatest} > 0 ]]; then
            if [ ! -f $HOME/.local/$(uname -m)/bin/reframe ]; then
                if [ -f $UV_TOOL_BIN_DIR/uv ]; then
                    uv tool install reframe-hpc
                fi
            fi
            if [ ! -d $HOME/Bin/spack ]; then
                cd $HOME/Bin
                git clone --depth=2 https://github.com/spack/spack
                . $HOME/Bin/spack/share/spack/setup-env.sh
                spack compiler find --scope site
                spack bootstrap now
            else
                . $HOME/Bin/spack/share/spack/setup-env.sh
            fi
        fi
    ;;
esac
unset __iatest


alias prun='podman run --rm -it -v $HOME:$HOME debian-toolchian-builder:latest'
alias pbuild='podman build -t debian-toolchian-builder -f debian-toolchian-builder '

